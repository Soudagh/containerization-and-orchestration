    {
      "parameters": {
        "jsCode": "const t = $('Разбор ответа').item.json;                                 const approver = $json['Кто подтверждает'];                             const q = s => \"'\" + String(s).replace(/'/g, \"''\") + \"'\";   // экранирование строк для SQL               \nconst now = \"strftime('%Y-%m-%dT%H:%M:%S','now')\";                      const book = t.mode === 'free'                                          // занять, только если стенд всё ещё свободен или бронь протухла    \n? `UPDATE reservations SET task=${q(t.task)}, owner=${q(t.requested_by)}, build=${q(t.build)},                        until=strftime('%Y-%m-%dT%H:%M:%S','now','+3 days'), note=${q('подобран агентом, подтвердил ' + approver)}                                      WHERE stand=${q(t.stand)} AND (task IS NULL OR until < ${now})`          // подселение: только если соседний тест на стенде всё ещё идёт  \n  : `UPDATE reservations SET note = note || ${q('; подселена ' + t.task)}  WHERE stand=${q(t.stand)} AND task IS NOT NULL AND until >= ${now}`;     const deploy = `INSERT INTO deployments (stand, task, build, approved_by)                                                      VALUES (${q(t.stand)}, ${q(t.task)}, ${q(t.build)}, ${q(approver)})`;\nreturn { ...t, approver, book_sql: book, deploy_sql: deploy };"
